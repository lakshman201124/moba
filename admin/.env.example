# Supabase dashboard -> Project Settings -> API Keys. PUBLISHABLE key only (sb_publishable_...).
# NEVER put the secret / service-role key in this file; the build refuses to run if it finds one.
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY work too.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY_HERE
# Where the customer menu lives. Table QR codes point here.
VITE_PUBLIC_MENU_URL=https://moba.cafe
